---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());

export const prerender = true;
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <section class="mb-10 overflow-hidden rounded-2xl border border-slate-700/80 bg-gradient-to-br from-slate-800 to-slate-900 shadow-xl" aria-labelledby="filter-heading">
      <div class="border-b border-slate-700/80 px-5 py-5 sm:px-7">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
          <div class="flex items-start gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-500/15 text-blue-300" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current stroke-2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M7 12h10m-7 6h4" /></svg>
            </div>
            <div>
              <h2 id="filter-heading" class="text-lg font-semibold text-slate-100">Find your next game</h2>
              <p class="mt-1 text-sm text-slate-400">Choose one or more options to narrow the collection.</p>
            </div>
          </div>
          <span id="results-count" class="inline-flex w-fit items-center rounded-full bg-slate-700/80 px-3 py-1 text-xs font-medium text-slate-300" aria-live="polite">
            {games.length} games
          </span>
        </div>
      </div>

      <div class="grid gap-7 px-5 py-6 sm:px-7 lg:grid-cols-2">
        <fieldset data-testid="category-filter" class="space-y-3">
          <legend class="text-sm font-semibold uppercase tracking-wider text-slate-300">Categories</legend>
          <div class="flex flex-wrap gap-2">
            {categories.map((category) => (
              <label class="group cursor-pointer">
                <input type="checkbox" value={category.name} data-filter-group="category" data-testid={`category-filter-${category.name.toLowerCase()}`} class="peer sr-only" />
                <span class="inline-flex items-center rounded-lg border border-slate-600 bg-slate-800/80 px-3 py-2 text-sm text-slate-300 transition hover:border-blue-400/70 hover:text-slate-100 peer-checked:border-blue-400 peer-checked:bg-blue-500/15 peer-checked:text-blue-200 peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500">
                  {category.name}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset data-testid="publisher-filter" class="space-y-3">
          <legend class="text-sm font-semibold uppercase tracking-wider text-slate-300">Publishers</legend>
          <div class="flex flex-wrap gap-2">
            {publishers.map((publisher) => (
              <label class="group cursor-pointer">
                <input type="checkbox" value={publisher.name} data-filter-group="publisher" data-testid={`publisher-filter-${publisher.name.toLowerCase().replaceAll(' ', '-')}`} class="peer sr-only" />
                <span class="inline-flex items-center rounded-lg border border-slate-600 bg-slate-800/80 px-3 py-2 text-sm text-slate-300 transition hover:border-purple-400/70 hover:text-slate-100 peer-checked:border-purple-400 peer-checked:bg-purple-500/15 peer-checked:text-purple-200 peer-focus-visible:ring-2 peer-focus-visible:ring-purple-500">
                  {publisher.name}
                </span>
              </label>
            ))}
          </div>
        </fieldset>
      </div>

      <div class="flex flex-col gap-4 border-t border-slate-700/80 bg-slate-950/20 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-7">
        <div class="flex min-h-8 flex-wrap items-center gap-2" id="selected-filters" aria-live="polite">
          <span class="text-sm text-slate-400">Selected:</span>
          <span class="text-sm text-slate-500" data-testid="no-filters-selected">None yet</span>
        </div>
        <div class="flex items-center gap-3">
          <button type="button" class="text-sm font-medium text-slate-400 transition hover:text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 focus:ring-offset-slate-900" data-testid="clear-filters-link" id="clear-filters-button">
            Clear all
          </button>
          <button type="button" class="inline-flex items-center justify-center rounded-lg bg-blue-700 px-4 py-2.5 text-sm font-semibold text-white shadow-lg shadow-blue-950/30 transition hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2 focus:ring-offset-slate-900" data-testid="apply-filters-button" id="apply-filters-button">
            Show matching games
          </button>
        </div>
      </div>
    </section>

    <div>
      <div class="mb-6 flex items-end justify-between gap-4">
        <div>
          <p class="mb-1 text-sm font-medium uppercase tracking-wider text-blue-400">Explore the collection</p>
          <h2 class="text-2xl font-semibold text-slate-100">Featured Games</h2>
        </div>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div
            data-testid="empty-state"
            class="hidden text-center py-12 bg-slate-800/50 backdrop-blur-sm rounded-xl border border-slate-700"
          >
            <p data-testid="empty-state-text" class="text-slate-300">No games match the selected filters.</p>
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterInputs = Array.from(document.querySelectorAll<HTMLInputElement>('input[data-filter-group]'));
  const applyButton = document.getElementById('apply-filters-button');
  const clearButton = document.getElementById('clear-filters-button');
  const selectedFilters = document.getElementById('selected-filters');
  const resultsCount = document.getElementById('results-count');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="empty-state"]');
  const allCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

  function updateSelectionTags() {
    const selectedCategories = filterInputs.filter((input) => input.checked && input.dataset.filterGroup === 'category').map((input) => input.value);
    const selectedPublishers = filterInputs.filter((input) => input.checked && input.dataset.filterGroup === 'publisher').map((input) => input.value);

    const tags = [];
    for (const name of selectedCategories) {
      tags.push(`<span class="rounded-full bg-blue-500/15 px-3 py-1 text-xs font-medium text-blue-200" data-testid="selected-category-tag">${name}</span>`);
    }
    for (const name of selectedPublishers) {
      tags.push(`<span class="rounded-full bg-purple-500/15 px-3 py-1 text-xs font-medium text-purple-200" data-testid="selected-publisher-tag">${name}</span>`);
    }

    const tagMarkup = tags.length > 0 ? tags.join('') : '<span class="text-sm text-slate-400" data-testid="no-filters-selected">No filters selected</span>';
    if (selectedFilters) {
      selectedFilters.innerHTML = `<span class="text-sm text-slate-300">Selected:</span>${tagMarkup}`;
    }
  }

  function applyFilters() {
    const selectedCategories = filterInputs.filter((input) => input.checked && input.dataset.filterGroup === 'category').map((input) => input.value);
    const selectedPublishers = filterInputs.filter((input) => input.checked && input.dataset.filterGroup === 'publisher').map((input) => input.value);

    for (const card of allCards) {
      const category = card.getAttribute('data-category');
      const publisher = card.getAttribute('data-publisher');
      const matchesCategory = selectedCategories.length === 0 || selectedCategories.includes(category ?? '');
      const matchesPublisher = selectedPublishers.length === 0 || selectedPublishers.includes(publisher ?? '');
      const shouldShow = matchesCategory && matchesPublisher;
      card.hidden = !shouldShow;
      card.style.display = shouldShow ? '' : 'none';
    }

    const visibleCards = allCards.filter((card) => !card.hidden && card.style.display !== 'none');
    if (emptyState) {
      emptyState.classList.toggle('hidden', visibleCards.length !== 0);
    }
    if (gamesGrid) {
      gamesGrid.style.display = visibleCards.length === 0 ? 'none' : '';
    }
    if (resultsCount) {
      resultsCount.textContent = `${visibleCards.length} ${visibleCards.length === 1 ? 'game' : 'games'}`;
    }

    updateSelectionTags();
  }

  function clearFilters() {
    for (const input of filterInputs) input.checked = false;
    applyFilters();
  }

  for (const input of filterInputs) input.addEventListener('change', updateSelectionTags);
  applyButton?.addEventListener('click', applyFilters);
  clearButton?.addEventListener('click', clearFilters);
  updateSelectionTags();
</script>
